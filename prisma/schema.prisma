generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "views"]
}

datasource db {
  provider = "postgresql"
  url      = env("RDS_POSTGRES_URL")
  schemas  = ["analytics"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model calendar_definition {
  id               Int       @id @default(autoincrement())
  calendar_id      String
  version          String
  display_name     String
  timezone         String
  calendar_type    String
  week_system      String
  week_start_day   Int       @db.SmallInt
  year_start_month Int       @default(1) @db.SmallInt
  description      String?
  effective_from   DateTime  @db.Date
  effective_to     DateTime? @db.Date
  lifecycle_state  String    @default("DRAFT")
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([calendar_id, version], map: "uq_calendar_definition")
  @@schema("analytics")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model data_asset {
  asset_id                 String
  version                  String              @default("1.0.0")
  object_schema            String              @default("analytics")
  object_name              String
  asset_type               String
  grain                    String
  owner_name               String
  data_classification      String              @default("INTERNAL")
  contains_pii             Boolean             @default(false)
  target_freshness_minutes Int?
  certification_state      String              @default("DRAFT")
  source_versions          Json?
  created_at               DateTime            @default(now()) @db.Timestamptz(6)
  updated_at               DateTime            @default(now()) @db.Timestamptz(6)
  id                       Int                 @id @default(autoincrement())
  data_quality_rule        data_quality_rule[]
  metric_lineage           metric_lineage[]
  refresh_batch            refresh_batch[]

  @@unique([object_schema, object_name, version], map: "uq_data_asset_object_version")
  @@unique([asset_id, version], map: "uq_data_asset_version")
  @@index([certification_state], map: "ix_data_asset_certification")
  @@index([object_schema, object_name], map: "ix_data_asset_object")
  @@schema("analytics")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model data_quality_rule {
  id              Int        @id @default(autoincrement())
  rule_id         String     @unique
  asset_id        String
  asset_version   String
  rule_name       String
  rule_type       String
  severity        String
  target_column   String?
  rule_config     Json       @default("{}")
  description     String
  lifecycle_state String     @default("DRAFT")
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime   @default(now()) @db.Timestamptz(6)
  data_asset      data_asset @relation(fields: [asset_id, asset_version], references: [asset_id, version], onDelete: NoAction, onUpdate: NoAction, map: "fk_data_quality_rule_asset")

  @@schema("analytics")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model dimension {
  dimension_id          String                  @unique(map: "uq_analytics_dimension_dimension_id")
  display_name          String
  description           String
  owner_name            String
  sensitivity_class     String                  @default("INTERNAL")
  allow_filter          Boolean                 @default(true)
  allow_group           Boolean                 @default(true)
  allow_sort            Boolean                 @default(true)
  lifecycle_state       String                  @default("DRAFT")
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  id                    Int                     @id @default(autoincrement())
  metric_dimension_rule metric_dimension_rule[]
  semantic_term         semantic_term[]

  @@schema("analytics")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model metric {
  metric_id       String           @unique(map: "uq_analytics_metric_metric_id")
  display_name    String
  description     String
  owner_name      String
  lifecycle_state String           @default("DRAFT")
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  id              Int              @id @default(autoincrement())
  metric_version  metric_version[]
  semantic_term   semantic_term[]

  @@schema("analytics")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model metric_dimension_rule {
  metric_id                                                                     String
  metric_version                                                                String
  dimension_id                                                                  String
  allow_filter                                                                  Boolean        @default(true)
  allow_group                                                                   Boolean        @default(true)
  allow_sort                                                                    Boolean        @default(true)
  lifecycle_state                                                               String         @default("DRAFT")
  notes                                                                         String?
  created_at                                                                    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                                                                    DateTime       @default(now()) @db.Timestamptz(6)
  id                                                                            Int            @id @default(autoincrement())
  dimension                                                                     dimension      @relation(fields: [dimension_id], references: [dimension_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_metric_dimension_rule_dimension")
  metric_version_metric_dimension_rule_metric_id_metric_versionTometric_version metric_version @relation("metric_dimension_rule_metric_id_metric_versionTometric_version", fields: [metric_id, metric_version], references: [metric_id, version], onDelete: NoAction, onUpdate: NoAction, map: "fk_metric_dimension_rule_metric_version")

  @@unique([metric_id, metric_version, dimension_id], map: "uq_metric_dimension_rule")
  @@index([dimension_id], map: "ix_metric_dimension_rule_dimension")
  @@schema("analytics")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model metric_lineage {
  metric_id                                                              String
  metric_version                                                         String
  asset_id                                                               String
  asset_version                                                          String
  lineage_role                                                           String         @default("PRIMARY")
  transformation_version                                                 String
  created_at                                                             DateTime       @default(now()) @db.Timestamptz(6)
  id                                                                     Int            @id @default(autoincrement())
  data_asset                                                             data_asset     @relation(fields: [asset_id, asset_version], references: [asset_id, version], onDelete: NoAction, onUpdate: NoAction, map: "fk_metric_lineage_data_asset")
  metric_version_metric_lineage_metric_id_metric_versionTometric_version metric_version @relation("metric_lineage_metric_id_metric_versionTometric_version", fields: [metric_id, metric_version], references: [metric_id, version], onDelete: NoAction, onUpdate: NoAction, map: "fk_metric_lineage_metric_version")

  @@unique([metric_id, metric_version, asset_id, asset_version], map: "uq_metric_lineage")
  @@schema("analytics")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model metric_version {
  metric_id                                                                            String
  version                                                                              String
  business_definition                                                                  String?
  grain                                                                                String?
  unit                                                                                 String?
  aggregation                                                                          String?
  time_mode                                                                            String?
  formula_ast                                                                          Json?
  formula_hash                                                                         String?
  null_zero_policy                                                                     String?
  reversal_policy                                                                      String?
  cancellation_reopen_policy                                                           String?
  currency_policy                                                                      Json?
  rounding_policy                                                                      String?
  additivity                                                                           String?
  late_arrival_restatement_policy                                                      String?
  freshness_max_age_minutes                                                            Int?
  reconciliation_policy                                                                Json?
  effective_from                                                                       DateTime                @default(now()) @db.Timestamptz(6)
  effective_to                                                                         DateTime?               @db.Timestamptz(6)
  lifecycle_state                                                                      String                  @default("DRAFT")
  created_at                                                                           DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                                                           DateTime                @default(now()) @db.Timestamptz(6)
  id                                                                                   Int                     @id @default(autoincrement())
  metric_dimension_rule_metric_dimension_rule_metric_id_metric_versionTometric_version metric_dimension_rule[] @relation("metric_dimension_rule_metric_id_metric_versionTometric_version")
  metric_lineage_metric_lineage_metric_id_metric_versionTometric_version               metric_lineage[]        @relation("metric_lineage_metric_id_metric_versionTometric_version")
  metric                                                                               metric                  @relation(fields: [metric_id], references: [metric_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_metric_version_metric")

  @@unique([metric_id, version], map: "uq_metric_version")
  @@index([metric_id], map: "ix_metric_version_metric")
  @@index([lifecycle_state], map: "ix_metric_version_state")
  @@schema("analytics")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model refresh_batch {
  id                     Int        @id @default(autoincrement())
  batch_key              String
  asset_id               String
  asset_version          String
  batch_type             String
  started_at             DateTime   @db.Timestamptz(6)
  completed_at           DateTime?  @db.Timestamptz(6)
  source_cutoff_at       DateTime?  @db.Timestamptz(6)
  status                 String
  row_count              BigInt?
  transformation_version String?
  data_quality_status    String     @default("NOT_ASSESSED")
  reconciliation_status  String     @default("NOT_ASSESSED")
  published              Boolean    @default(false)
  notes                  String?
  created_at             DateTime   @default(now()) @db.Timestamptz(6)
  updated_at             DateTime   @default(now()) @db.Timestamptz(6)
  data_asset             data_asset @relation(fields: [asset_id, asset_version], references: [asset_id, version], onDelete: NoAction, onUpdate: NoAction, map: "fk_refresh_batch_asset")

  @@unique([asset_id, asset_version, batch_key], map: "uq_refresh_batch")
  @@schema("analytics")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model semantic_term {
  locale            String
  term              String
  target_type       String
  metric_id         String?
  dimension_id      String?
  is_preferred_term Boolean    @default(false)
  lifecycle_state   String     @default("DRAFT")
  notes             String?
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  updated_at        DateTime   @default(now()) @db.Timestamptz(6)
  id                Int        @id @default(autoincrement())
  dimension         dimension? @relation(fields: [dimension_id], references: [dimension_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_semantic_term_dimension")
  metric            metric?    @relation(fields: [metric_id], references: [metric_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_semantic_term_metric")

  @@schema("analytics")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model snapshot_manifest {
  id                     Int       @id @default(autoincrement())
  snapshot_id            String
  version                String
  dataset_id             String
  dataset_version        String
  snapshot_at            DateTime  @db.Timestamptz(6)
  reporting_timezone     String
  snapshot_type          String
  business_period_label  String?
  synthetic_data         Boolean   @default(false)
  certification_state    String
  source_cutoff_at       DateTime? @db.Timestamptz(6)
  data_quality_status    String
  reconciliation_status  String
  refresh_batch_key      String?
  asset_manifest         Json
  metric_manifest        Json
  output_hash            String
  supersedes_snapshot_id String?
  supersedes_version     String?
  restated               Boolean   @default(false)
  restatement_reason     String?
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  created_by             String    @default(dbgenerated("CURRENT_USER"))

  @@unique([snapshot_id, version], map: "uq_snapshot_manifest")
  @@schema("analytics")
}

model answer {
  id                    Int                   @id @default(autoincrement())
  answer_uuid           String                @unique @db.Uuid
  request_uuid          String                @db.Uuid
  policy_decision_uuid  String?               @db.Uuid
  conversation_id       Int
  message_id            Int?
  status                answer_status
  locale                locale_code           @default(en)
  retention_class       retention_class       @default(STANDARD)
  journey_no            Int?
  plan_hash             String?
  normalized_plan       Json?
  metric_versions       Json?
  dataset_id            String?
  dataset_version       String?
  period_start          DateTime?             @db.Timestamptz(6)
  period_end            DateTime?             @db.Timestamptz(6)
  as_of                 DateTime?             @db.Timestamptz(6)
  structured_result_ref String?
  warnings              Json?
  synthetic_label       Boolean               @default(true)
  narration_source      narration_source?
  policy_version        String?
  scope_hash            String?
  query_fingerprint     String?
  output_hash           String?
  version               Int                   @default(1)
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  published_at          DateTime?             @db.Timestamptz(6)
  expires_at            DateTime?             @db.Timestamptz(6)
  conversation          conversation          @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  conversation_message  conversation_message? @relation(fields: [message_id], references: [id])
  export_job            export_job[]
  model_usage           model_usage[]
  report_run            report_run[]
  saved_question        saved_question[]
  user_feedback         user_feedback[]

  @@index([conversation_id, created_at])
  @@index([request_uuid])
  @@schema("analytics")
}

model audit_event {
  id                 BigInt   @id @default(autoincrement())
  event_day          DateTime @db.Date
  sequence           Int
  previous_hash      String?
  event_hash         String
  signature_manifest String?
  request_uuid       String   @db.Uuid
  conversation_id    Int?
  subject_ref        String?
  event_type         String
  plan_hash          String?
  policy_version     String?
  scope_hash         String?
  query_fingerprint  String?
  output_hash        String?
  status             String?
  warning_codes      String[]
  redacted_payload   Json?
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@unique([event_day, sequence])
  @@index([event_type, created_at])
  @@index([request_uuid])
  @@schema("analytics")
}

model conversation {
  id                   Int                    @id @default(autoincrement())
  conversation_uuid    String                 @unique @db.Uuid
  owner_user_id        Int
  locale               locale_code            @default(en)
  state                conversation_state     @default(ACTIVE)
  retention_class      retention_class        @default(STANDARD)
  dataset_id           String?
  dataset_version      String?
  analytical_context   Json?
  version              Int                    @default(1)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @db.Timestamptz(6)
  deleted_at           DateTime?              @db.Timestamptz(6)
  answer               answer[]
  users                users                  @relation(fields: [owner_user_id], references: [user_id], onDelete: Cascade)
  conversation_message conversation_message[]

  @@index([owner_user_id, created_at])
  @@schema("analytics")
}

model conversation_message {
  id                  Int          @id @default(autoincrement())
  conversation_id     Int
  role                message_role
  kind                message_kind
  text                String?
  text_redacted       Boolean      @default(false)
  question_hash       String?
  locale              locale_code  @default(en)
  request_uuid        String?      @unique @db.Uuid
  idempotency_key     String?
  canonical_body_hash String?
  created_at          DateTime     @default(now()) @db.Timestamptz(6)
  answer              answer[]
  conversation        conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, idempotency_key])
  @@index([conversation_id, created_at])
  @@schema("analytics")
}

model evaluation_run {
  id               Int               @id @default(autoincrement())
  suite            String
  release_version  String
  semantic_version String?
  dataset_id       String?
  dataset_version  String?
  prompt_version   String?
  model_version    String?
  policy_version   String?
  total_checks     Int
  passed_checks    Int
  failed_checks    Int
  result           evaluation_result
  details          Json?
  started_at       DateTime          @db.Timestamptz(6)
  finished_at      DateTime?         @db.Timestamptz(6)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)

  @@index([release_version, created_at])
  @@schema("analytics")
}

model export_job {
  id              Int             @id @default(autoincrement())
  export_uuid     String          @unique @db.Uuid
  answer_id       Int?
  owner_user_id   Int
  format          export_format
  state           job_state       @default(QUEUED)
  artifact_state  artifact_state?
  artifact_ref    String?
  scope_hash      String?
  masking_profile String?
  idempotency_key String?
  synthetic_label Boolean         @default(true)
  error_code      String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  completed_at    DateTime?       @db.Timestamptz(6)
  expires_at      DateTime?       @db.Timestamptz(6)
  revoked_at      DateTime?       @db.Timestamptz(6)
  answer          answer?         @relation(fields: [answer_id], references: [id])

  @@unique([owner_user_id, idempotency_key])
  @@index([owner_user_id, expires_at])
  @@schema("analytics")
}

model model_usage {
  id             Int      @id @default(autoincrement())
  request_uuid   String   @db.Uuid
  answer_id      Int?
  provider       String
  model          String
  prompt_version String?
  purpose        String
  input_tokens   Int?
  output_tokens  Int?
  latency_ms     Int?
  estimated_cost Decimal? @db.Decimal(12, 6)
  retry_count    Int      @default(0)
  status         String
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  answer         answer?  @relation(fields: [answer_id], references: [id])

  @@index([created_at])
  @@index([request_uuid])
  @@schema("analytics")
}

model report_definition {
  id                Int               @id @default(autoincrement())
  owner_user_id     Int
  title             String
  state             definition_state  @default(DRAFT)
  report_template   String?
  config            Json
  filters           Json?
  metric_versions   Json
  saved_question_id Int?
  version           Int               @default(1)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @db.Timestamptz(6)
  saved_question    saved_question?   @relation(fields: [saved_question_id], references: [id])
  report_schedule   report_schedule[]

  @@index([owner_user_id])
  @@schema("analytics")
}

model report_run {
  id               Int             @id @default(autoincrement())
  schedule_id      Int
  planned_run_at   DateTime        @db.Timestamptz(6)
  state            job_state       @default(QUEUED)
  answer_id        Int?
  artifact_ref     String?
  artifact_state   artifact_state?
  error_code       String?
  lease_owner      String?
  lease_expires_at DateTime?       @db.Timestamptz(6)
  heartbeat_at     DateTime?       @db.Timestamptz(6)
  started_at       DateTime?       @db.Timestamptz(6)
  finished_at      DateTime?       @db.Timestamptz(6)
  expires_at       DateTime?       @db.Timestamptz(6)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  answer           answer?         @relation(fields: [answer_id], references: [id])
  report_schedule  report_schedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@unique([schedule_id, planned_run_at])
  @@index([lease_expires_at])
  @@schema("analytics")
}

model report_schedule {
  id                   Int               @id @default(autoincrement())
  report_definition_id Int
  owner_user_id        Int
  timezone             String            @default("Europe/Rome")
  cadence              schedule_cadence
  state                schedule_state    @default(DRAFT)
  metric_versions      Json
  next_run_at          DateTime?         @db.Timestamptz(6)
  lease_owner          String?
  lease_expires_at     DateTime?         @db.Timestamptz(6)
  heartbeat_at         DateTime?         @db.Timestamptz(6)
  version              Int               @default(1)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @db.Timestamptz(6)
  report_run           report_run[]
  report_definition    report_definition @relation(fields: [report_definition_id], references: [id], onDelete: Cascade)

  @@index([lease_expires_at])
  @@index([state, next_run_at])
  @@schema("analytics")
}

model roles {
  role_id     Int       @id @default(autoincrement())
  name        String
  role_code   String    @unique
  description String?
  created_at  DateTime? @default(now())
  updated_at  DateTime?
  notes       String?
  is_active   Boolean   @default(true)
  updated_by  String?
  users       users[]

  @@schema("analytics")
}

model saved_question {
  id                Int                 @id @default(autoincrement())
  owner_user_id     Int
  title             String
  version           Int                 @default(1)
  normalized_plan   Json
  plan_hash         String?
  metric_versions   Json
  locale            locale_code         @default(en)
  source_answer_id  Int?
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @db.Timestamptz(6)
  archived_at       DateTime?           @db.Timestamptz(6)
  report_definition report_definition[]
  answer            answer?             @relation(fields: [source_answer_id], references: [id])

  @@unique([owner_user_id, title, version])
  @@schema("analytics")
}

model user_feedback {
  id           Int                   @id @default(autoincrement())
  answer_id    Int
  user_id      Int
  category     feedback_category
  comment      String?
  review_state feedback_review_state @default(NEW)
  reviewed_by  String?
  reviewed_at  DateTime?             @db.Timestamptz(6)
  created_at   DateTime              @default(now()) @db.Timestamptz(6)
  answer       answer                @relation(fields: [answer_id], references: [id], onDelete: Cascade)

  @@unique([answer_id, user_id, category])
  @@index([review_state, created_at])
  @@schema("analytics")
}

model users {
  user_id           Int            @id @default(autoincrement())
  username          String         @unique
  password_hash     String
  full_name         String?
  email             String?        @unique
  mobile            String?        @unique
  emergency_contact String?
  notes             String?
  is_active         Boolean        @default(true)
  role_id           String
  created_at        DateTime       @default(now())
  refresh_token     String?
  updated_at        DateTime?
  updated_by        String?
  src_hash          String?
  conversation      conversation[]
  roles             roles          @relation(fields: [role_id], references: [role_code])

  @@schema("analytics")
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view v_asset_publishability {
  asset_id          String?
  asset_version     String?
  analytical_object String?
  trust_state       String?
  may_execute       Boolean?
  warning_required  Boolean?
  reason_code       String?

  @@ignore
  @@schema("analytics")
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view v_asset_trust_status {
  asset_id                     String?
