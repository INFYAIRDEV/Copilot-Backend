PORT=3000
NODE_ENV=development
# Must match the env() name in prisma/schema.prisma. For Cloud SQL add: ?sslmode=require
RDS_POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
CRON_ENABLED=true
# Password hashing cost (allowed 10 to 15, default 12)
BCRYPT_SALT_ROUNDS=12

# Email (SMTP) - used to send OTP emails
EMAIL_SERVICE_PROVIDER_SMTP_HOST=smtp.gmail.com
EMAIL_SERVICE_PROVIDER_SMTP_PORT=587
EMAIL_SENDER_ID=your_sender_address@gmail.com
EMAIL_SENDER_NAME=Infysuite Copilot
EMAIL_SENDER_PWD=your_smtp_or_app_password
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_GREETING_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=15000
# EMAIL_FROM_ADDRESS=no-reply@yourdomain.com

# Secret used to hash OTP codes (minimum 32 characters)
OTP_HMAC_SECRET=change_me_to_a_random_string_of_at_least_32_chars